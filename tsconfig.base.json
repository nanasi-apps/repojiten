{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@repojiten/frontend-app/*": ["packages/frontend/app/src/*"],
      "@repojiten/frontend-domain/*": ["packages/frontend/domain/src/*"],
      "@repojiten/frontend-api/*": ["packages/frontend/api/src/*"],
      "@repojiten/frontend-api": ["packages/frontend/api/src/index.ts"],
      "@repojiten/frontend-ui/*": ["packages/frontend/ui/src/*"],
      "@repojiten/frontend-ui": ["packages/frontend/ui/src/index.ts"],
      "@repojiten/backend-types/*": ["packages/backend/types/src/*"],
      "@repojiten/backend-types": ["packages/backend/types/src/index.ts"],
      "@repojiten/backend-domain/*": ["packages/backend/domain/src/*"],
      "@repojiten/backend-domain": ["packages/backend/domain/src/index.ts"],
      "@repojiten/backend-usecases/*": ["packages/backend/usecases/src/*"],
      "@repojiten/backend-usecases": ["packages/backend/usecases/src/index.ts"],
      "@repojiten/backend-http/*": ["packages/backend/http/src/*"],
      "@repojiten/backend-http": ["packages/backend/http/src/index.ts"],
      "@repojiten/backend-persistence/*": ["packages/backend/persistence/src/*"],
      "@repojiten/backend-persistence": ["packages/backend/persistence/src/index.ts"],
      "@repojiten/backend-app/*": ["packages/backend/app/src/*"],
      "@repojiten/backend-app": ["packages/backend/app/src/index.ts"],
      "@repojiten/backend-entry/*": ["packages/backend/entry/src/*"],
      "@repojiten/backend-entry": ["packages/backend/entry/src/index.ts"],
      "@repojiten/backend-drizzle/*": ["packages/backend/drizzle/src/*"],
      "@repojiten/backend-drizzle": ["packages/backend/drizzle/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", "build", ".wrangler"]
}
