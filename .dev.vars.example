# ローカル開発用の secret / 環境変数の例。
# このファイルを `.dev.vars` にコピーして値を設定してください（`.dev.vars` は gitignore 済み）。
# secret 値は repository に commit しないでください。

# GitHub webhook 署名検証に使う共有 secret（GitHub Webhook の Secret と一致させる）
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth（#2 認証で利用）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# session 署名 secret（#2 認証で利用）
SESSION_SECRET=""

# デプロイ先の公開ベース URL
APP_BASE_URL="http://localhost:8787"
